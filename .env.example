# Copy to .env and fill in. Never commit .env.
# Groq key from https://console.groq.com/keys (GROQ_API_KEY also works).
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30
LLM_REASONING_EFFORT=low
# Upper limit on reply tokens. Each call asks only for what its reply needs (500 + 85 per
# pick), because Groq counts the whole cap against the tokens-per-minute limit.
LLM_MAX_COMPLETION_TOKENS=1400
# Restaurants passed to the LLM per request (SHORTLIST_SIZE also works).
CANDIDATE_CAP=10
# Relative paths resolve from the project root.
DATA_DIR=data
# Production only: the API then rejects requests without a matching x-origin-secret
# header (Vercel adds it). Leave empty locally.
ORIGIN_SECRET=

# --- Limits (defaults shown; 0 turns each off). See docs/deployment-plan.md. ---
# LLM calls across all users; past these, searches get the pre-ranked fallback.
LLM_CALLS_PER_MINUTE=3
LLM_CALLS_PER_DAY=100
# Searches per visitor (by IP); past these the API answers 429.
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=60
# Finished AI answers kept in memory, so a repeated search costs no tokens.
RESPONSE_CACHE_SIZE=256
# Longest a search waits for the LLM before serving the fallback.
REQUEST_DEADLINE_SECONDS=25
LOG_LEVEL=INFO
