# Copy to .env and fill in. Never commit .env.
# Groq key from https://console.groq.com/keys (GROQ_API_KEY also works).
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30
LLM_REASONING_EFFORT=low
# Upper limit on reply tokens. Each call asks only for what its reply needs (400 + 85 per
# pick), because Groq counts the whole cap against the tokens-per-minute limit.
LLM_MAX_COMPLETION_TOKENS=1280
# Restaurants passed to the LLM per request (SHORTLIST_SIZE also works).
CANDIDATE_CAP=10
# Relative paths resolve from the project root.
DATA_DIR=data
